# Optional absolute override for home-api (no trailing slash).
# Leave unset/empty to use same-origin relative /api
# (Vite proxies /api → http://localhost:8082 in dev;
# the container nginx proxies /api via HOME_API_UPSTREAM).
# VITE_HOME_API_BASE_URL=http://localhost:8082
# Optional Pi pairing API (LAN). Default: http://breathinghouse.local:8090
# VITE_GATEWAY_BASE_URL=http://breathinghouse.local:8090
