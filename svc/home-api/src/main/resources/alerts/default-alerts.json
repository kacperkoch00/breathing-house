{
  "evaluationInterval": "10s",
  "alerts": [
    {
      "id": "high-co2",
      "enabled": true,
      "type": "THRESHOLD",
      "source": "ENVIRONMENT",
      "sensorType": "AIR",
      "metric": "CO2",
      "operator": "GREATER_THAN",
      "threshold": 1500,
      "for": "5m",
      "maxDataAge": "2m",
      "severity": "WARNING",
      "rooms": ["*"],
      "message": "CO2 in {{roomId}} is {{value}} ppm"
    },
    {
      "id": "high-humidity",
      "enabled": true,
      "type": "THRESHOLD",
      "source": "ENVIRONMENT",
      "sensorType": "AIR",
      "metric": "HUMIDITY",
      "operator": "GREATER_THAN",
      "threshold": 70,
      "for": "30m",
      "maxDataAge": "2m",
      "severity": "WARNING",
      "rooms": ["*"],
      "message": "Humidity in {{roomId}} is {{value}}%"
    },
    {
      "id": "low-humidity",
      "enabled": true,
      "type": "THRESHOLD",
      "source": "ENVIRONMENT",
      "sensorType": "AIR",
      "metric": "HUMIDITY",
      "operator": "LESS_THAN",
      "threshold": 30,
      "for": "30m",
      "maxDataAge": "2m",
      "severity": "INFO",
      "rooms": ["*"],
      "message": "Humidity in {{roomId}} is {{value}}%"
    },
    {
      "id": "high-temperature",
      "enabled": true,
      "type": "THRESHOLD",
      "source": "ENVIRONMENT",
      "sensorType": "ROOM",
      "metric": "TEMPERATURE",
      "operator": "GREATER_THAN",
      "threshold": 28,
      "for": "30m",
      "maxDataAge": "2m",
      "severity": "WARNING",
      "rooms": ["*"],
      "message": "Temperature in {{roomId}} is {{value}} C"
    },
    {
      "id": "low-temperature",
      "enabled": true,
      "type": "THRESHOLD",
      "source": "ENVIRONMENT",
      "sensorType": "ROOM",
      "metric": "TEMPERATURE",
      "operator": "LESS_THAN",
      "threshold": 15,
      "for": "30m",
      "maxDataAge": "2m",
      "severity": "WARNING",
      "rooms": ["*"],
      "message": "Temperature in {{roomId}} is {{value}} C"
    },
    {
      "id": "opening-left-open",
      "enabled": true,
      "type": "BOOLEAN_STATE",
      "source": "OCCUPANCY",
      "eventType": "OPENING",
      "field": "OPEN",
      "expected": true,
      "for": "15m",
      "severity": "WARNING",
      "rooms": ["*"],
      "message": "An opening in {{roomId}} has been open for {{duration}}"
    },
    {
      "id": "air-data-stale",
      "enabled": true,
      "type": "STALE_DATA",
      "source": "ENVIRONMENT",
      "sensorType": "AIR",
      "for": "5m",
      "severity": "INFO",
      "rooms": ["*"],
      "message": "No recent air reading for {{roomId}}"
    },
    {
      "id": "room-data-stale",
      "enabled": true,
      "type": "STALE_DATA",
      "source": "ENVIRONMENT",
      "sensorType": "ROOM",
      "for": "5m",
      "severity": "INFO",
      "rooms": ["*"],
      "message": "No recent room reading for {{roomId}}"
    }
  ]
}
