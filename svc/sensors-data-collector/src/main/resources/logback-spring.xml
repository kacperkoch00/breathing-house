<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
    Emits one ECS-formatted JSON object per event so Loki can parse levels,
    logger names and stack traces as fields instead of opaque text.
    The format itself is selected by logging.structured.format.console.
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>

    <logger name="com.breathinghouse.sensorsdatacollector" level="${LOG_LEVEL:-INFO}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
